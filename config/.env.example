# ============================================================================
# WeatherNext Utility Forecasting — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp config/.env.example config/.env
# ============================================================================

# GCP Project & Dataset
GCP_PROJECT=your-gcp-project-id
DATASET_NAME=weathernext_demo
GCS_BUCKET=your-eaglei-bucket
GCS_BUCKET_LOCATION=us-central1

# WeatherNext Graph table (from Analytics Hub subscription)
WEATHERNEXT_TABLE=your-project.weathernext_graph_forecasts.59572747_4_0

# Area of Interest — comma-separated 5-digit county FIPS codes
# https://transition.fcc.gov/oet/info/maps/census/fips/fips.txt
# Examples:
#   Alabama demo:    01051,01101
#   Florida panhandle: 12005,12013,12033,12045,12059,12063,12077,12091,12113,12131
#   Full state:      (use all FIPS for that state)
COUNTY_FIPS=01051,01101

# Time Window
START_DATE=2024-05-06
END_DATE=2024-05-15

# Forecast Lead Range (hours)
MIN_LEAD_HOURS=24
MAX_LEAD_HOURS=48

# Risk Scoring Thresholds
WIND_THRESHOLD_LOW=5.0       # m/s — below = negligible risk
WIND_THRESHOLD_HIGH=25.0     # m/s — at/above = maximum risk
PRECIP_THRESHOLD_LOW=0.0     # mm
PRECIP_THRESHOLD_HIGH=50.0   # mm — heavy 6h accumulation
WIND_WEIGHT=0.7              # Weight for wind in risk formula
PRECIP_WEIGHT=0.3            # Weight for precipitation in risk formula

# EAGLE-I Data
LOCAL_EAGLEI_CSV_PATH=./data/eaglei_outages_2024.csv
GCS_EAGLEI_CSV_PATH=eaglei_outages_2024.csv
