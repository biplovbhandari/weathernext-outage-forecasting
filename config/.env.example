# ============================================================================
# WeatherNext Utility Forecasting — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp config/.env.example config/.env
# ============================================================================

# GCP Project & Dataset
GCP_PROJECT=your-gcp-project-id
DATASET_NAME=weathernext_demo
GCS_BUCKET=your-eaglei-bucket
GCS_BUCKET_LOCATION=us-central1

# WeatherNext Graph table (from Analytics Hub subscription)
WEATHERNEXT_TABLE=your-project.weathernext_graph_forecasts.59572747_4_0

# Area of Interest — comma-separated 5-digit county FIPS codes
# https://transition.fcc.gov/oet/info/maps/census/fips/fips.txt
# Examples:
#   Alabama demo:    01051,01101
#   Florida panhandle: 12005,12013,12033,12045,12059,12063,12077,12091,12113,12131
#   Full state:      (use all FIPS for that state)
COUNTY_FIPS=01051,01101

# Time Window
START_DATE=2024-05-06
END_DATE=2024-05-15

# Specific lead hours to extract (comma-separated, 6h increments)
# WeatherNext forecasts at 6h temporal resolution
LEAD_HOURS=24,30,36,42,48

# Forecast initialization hours (UTC, comma-separated)
# 00Z = midnight run, 12Z = noon run
# Use 0 for 00Z only (default), or 0,12 for both 00Z and 12Z
INIT_HOURS=0

# Spatial buffer around county boundaries (meters) for weather grid matching
SPATIAL_BUFFER_M=25000

# Outage threshold for ML training (fraction of customers, e.g., 0.05 = 5%)
OUTAGE_THRESHOLD=0.05

# Event Detection
EVENT_OUTAGE_THRESHOLD=0.005   # Minimum outage ratio to flag (0.5% of customers)
EVENT_GAP_MINUTES=60           # Max gap between readings to merge into one event

# QC minimum samples per 6-hour block (at 15-min cadence, expect ~24)
MIN_SAMPLES_PER_BLOCK=8

# EAGLE-I Data
LOCAL_EAGLEI_CSV_PATH=./data/eaglei_outages_2024.csv
GCS_EAGLEI_CSV_PATH=eaglei_outages_2024.csv
