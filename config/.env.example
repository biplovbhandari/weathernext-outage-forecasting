# ==============================================================================
# WeatherNext Utility Forecasting — Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp config/.env.example config/.env
# ==============================================================================

# --- GCP & Dataset (shared across all phases) --------------------------------
GCP_PROJECT=your-gcp-project-id
DATASET_NAME=weathernext_demo
WEATHERNEXT_TABLE=your-project.weathernext_graph_forecasts.59572747_4_0

# --- Data Selection (shared across all phases) --------------------------------
# 5-digit FIPS codes, comma-separated
# https://transition.fcc.gov/oet/info/maps/census/fips/fips.txt
# Examples:
#   Alabama demo:    01051,01101
#   Florida panhandle: 12005,12013,12033,12045,12059,12063,12077,12091,12113,12131
#   Full state:      (use all FIPS for that state)
COUNTY_FIPS=01051,01101
# Analysis window (YYYY-MM-DD)
START_DATE=2024-05-06
END_DATE=2024-05-15
# Forecast lead times in hours (6h increments)
LEAD_HOURS=24,30,36,42,48
# Forecast initialization hours UTC (0 = 00Z only; 0,12 = 00Z+12Z)
INIT_HOURS=0

# --- Data Ingestion (setup phase only) ---------------------------------------
GCS_BUCKET=your-eaglei-bucket
GCS_BUCKET_LOCATION=us-central1
LOCAL_EAGLEI_CSV_PATH=./data/eaglei_outages_2024.csv
GCS_EAGLEI_CSV_PATH=eaglei_outages_2024.csv

# --- Correlation Phase --------------------------------------------------------
# Buffer distance (meters) around county geometry for spatial join with WeatherNext grid
SPATIAL_BUFFER_M=25000
# Outage ratio threshold for binary classification (0.05 = 5% of customers)
OUTAGE_THRESHOLD=0.05
# Min outage ratio to flag as event start (0.005 = 0.5%)
EVENT_OUTAGE_THRESHOLD=0.005
# Max gap (minutes) between readings before splitting into separate events
EVENT_GAP_MINUTES=60
# Min EAGLE-I readings per 6h block for QC (expect ~24 at full 15-min cadence)
MIN_SAMPLES_PER_BLOCK=8
# Hail detection: 700hPa temperature threshold (°C) and min precipitation (mm)
HAIL_TEMP_THRESHOLD=0.0
HAIL_PRECIP_THRESHOLD=2.0
# Min number of lead times that must flag wind/hail for HIGH risk tier
WIND_CONSISTENCY_MIN=2
HAIL_CONSISTENCY_MIN=1

# --- ML Phase -----------------------------------------------------------------
# Which models to train and evaluate (comma-separated)
# Options: regressor, classifier, logistic, automl
ML_MODELS=regressor,logistic
# BQML boosted tree hyperparameters
ML_MAX_ITERATIONS=50
ML_LEARN_RATE=0.1
ML_MIN_TREE_CHILD_WEIGHT=5
ML_SUBSAMPLE=0.8
# AutoML budget (hours) — only used if AUTOML model type is uncommented in SQL
ML_BUDGET_HOURS=1.0
